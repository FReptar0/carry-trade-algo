# OANDA Practice Account Credentials
# Get these from: https://www.oanda.com/ -> Account Settings -> API
OANDA_ACCESS_TOKEN=your-practice-api-token-here
OANDA_ACCOUNT_ID=101-001-12345678-001
OANDA_ENVIRONMENT=practice

# Trading Configuration
TRADING_PAIRS=USD/JPY,AUD/JPY
POSITION_SIZE_UNITS=10000
CHECK_INTERVAL_MIN=60
INITIAL_EQUITY=100000

# Telegram Alerts (Phase A)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Finnhub API (Phase A - Live Calendar)
FINNHUB_API_KEY=your-finnhub-api-key-here

# Paths (relative to /app inside container)
LOG_DIR=logs
DB_PATH=data/trading.db
